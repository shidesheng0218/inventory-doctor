{
  "name": "inventory-doctor",
  "version": "0.2.0",
  "description": "Multi-source inventory sync diagnostics — find the SKUs you're overselling without knowing it.",
  "type": "module",
  "packageManager": "pnpm@11.7.0",
  "license": "MIT",
  "author": "Mike Shi",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/shidesheng0218/inventory-doctor.git"
  },
  "homepage": "https://github.com/shidesheng0218/inventory-doctor#readme",
  "bugs": {
    "url": "https://github.com/shidesheng0218/inventory-doctor/issues"
  },
  "keywords": [
    "shopify",
    "inventory",
    "sync",
    "mcp",
    "cli",
    "ecommerce",
    "oversell"
  ],
  "engines": {
    "node": ">=22"
  },
  "main": "./dist/run.js",
  "types": "./dist/run.d.ts",
  "exports": {
    ".": {
      "types": "./dist/run.d.ts",
      "default": "./dist/run.js"
    },
    "./core": {
      "types": "./dist/core/diagnose.d.ts",
      "default": "./dist/core/diagnose.js"
    },
    "./types": {
      "types": "./dist/core/types.d.ts",
      "default": "./dist/core/types.js"
    },
    "./snapshots": {
      "types": "./dist/snapshots.d.ts",
      "default": "./dist/snapshots.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "inventory-doctor": "./dist/cli.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "fixtures"
  ],
  "scripts": {
    "dev": "tsx src/cli.ts",
    "mcp": "tsx src/mcp.ts",
    "test": "vitest run",
    "build": "tsc && node scripts/add-shebang.mjs",
    "typecheck": "tsc --noEmit",
    "check:stdout": "! grep -rn 'console\\.log' src/",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.30.0",
    "zod": "^3.25.0",
    "commander": "^12.0.0",
    "papaparse": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/papaparse": "^5.3.14",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^2.1.0"
  }
}
